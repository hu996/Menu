@model RestaurantMenuPlatform.Web.Models.RestaurantCreateViewModel
@{ ViewData["Title"] = "Create restaurant"; }
<div class="page-header"><span class="eyebrow">Authenticated setup · Step 01</span><h1>Create your restaurant</h1><p class="muted">Save the restaurant first. Branches, menus, categories, and products are managed independently from its workspace.</p></div>
<div class="setup-context-banner"><strong>Restaurant first.</strong><span>Your existing account will become the owner of this new restaurant workspace.</span></div>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="form-stack premium-form" data-upload-form>
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="form-section">
        <div class="form-section-heading"><span class="eyebrow">Identity</span><h2>Restaurant information</h2><p>Only restaurant-level identity and contact fields belong in this step.</p></div>
        <div class="form-grid">
            <div class="form-field"><label asp-for="NameEn"></label><input asp-for="NameEn" autocomplete="organization" /><span asp-validation-for="NameEn" class="field-validation"></span></div>
            <div class="form-field"><label asp-for="NameAr"></label><input asp-for="NameAr" dir="rtl" /><span class="field-hint">Arabic display name.</span></div>
            <div class="form-field"><label asp-for="Slug"></label><input asp-for="Slug" placeholder="your-restaurant" autocomplete="off" /><span class="field-hint">Permanent address used by the workspace and public menu links.</span><span asp-validation-for="Slug" class="field-validation"></span></div>
            <div class="form-field"><label asp-for="Phone"></label><input asp-for="Phone" autocomplete="tel" /></div>
            <div class="form-field"><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" /></div>
            <div class="form-field form-field-full"><label asp-for="Address"></label><textarea asp-for="Address" rows="3"></textarea></div>
        </div>
    </section>
    <section class="form-section">
        <div class="form-section-heading"><span class="eyebrow">Branding</span><h2>Restaurant presentation</h2><p>Branding remains optional and is checked against the selected plan.</p></div>
        <div class="form-grid">
            <div class="form-field"><label asp-for="LogoFile"></label><input asp-for="LogoFile" type="file" accept="image/jpeg,image/png,image/webp" data-image-input /><span class="field-hint">JPEG, PNG, or WebP · max 5 MB.</span><span asp-validation-for="LogoFile" class="field-validation"></span><div class="upload-preview-grid" data-preview-logo></div></div>
            <div class="form-field"><label asp-for="CoverFile"></label><input asp-for="CoverFile" type="file" accept="image/jpeg,image/png,image/webp" data-cover-input /><span class="field-hint">JPEG, PNG, or WebP · max 5 MB.</span><span asp-validation-for="CoverFile" class="field-validation"></span><div class="upload-preview-grid" data-preview-cover></div></div>
            <div class="form-field"><label asp-for="BrandPrimaryColor"></label><input asp-for="BrandPrimaryColor" type="color" /></div>
            <div class="form-field"><label asp-for="BrandAccentColor"></label><input asp-for="BrandAccentColor" type="color" /></div>
        </div>
    </section>
    <section class="form-section">
        <div class="form-section-heading"><span class="eyebrow">Defaults</span><h2>Language and currency</h2><p>These choices come from the active global lookup catalog.</p></div>
        <div class="form-grid">
            <div class="form-field"><label asp-for="Currency"></label><select asp-for="Currency"><option value="">Select currency</option>@foreach (var currency in Model.Currencies) { <option value="@currency.Code">@UiText.Business(currency.NameEn, currency.NameEn, currency.NameAr) (@currency.Code)</option> }</select><span asp-validation-for="Currency" class="field-validation"></span></div>
            <div class="form-field"><label asp-for="DefaultLanguage"></label><select asp-for="DefaultLanguage"><option value="">Select language</option>@foreach (var language in Model.Languages) { <option value="@language.Code">@UiText.Business(language.NameEn, language.NameEn, language.NameAr)</option> }</select><span asp-validation-for="DefaultLanguage" class="field-validation"></span></div>
        </div>
    </section>
    @Html.AntiForgeryToken()
    <div class="form-actions-sticky"><a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save restaurant &amp; continue</button></div>
</form>
