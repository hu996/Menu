@model RestaurantMenuPlatform.Application.DTOs.DashboardDto
@{ ViewData["Title"] = "Restaurant workspace"; var tenantSlug = User.FindFirst("tenant_slug")?.Value ?? Context.Request.RouteValues["tenantSlug"]?.ToString(); var tenantPath = string.IsNullOrWhiteSpace(tenantSlug) ? string.Empty : $"/r/{Uri.EscapeDataString(tenantSlug)}"; }
<div class="dashboard-intro"><div><span class="eyebrow">Restaurant workspace</span><h1>@UiText.Business(Model.RestaurantName, Model.RestaurantName, Model.RestaurantNameAr)</h1><p class="muted">Your saved restaurant is ready. Build the guest experience one business object at a time.</p></div><a class="btn btn-secondary" href="@(tenantPath)/Restaurant/Index">Restaurant settings</a></div>
<partial name="_SetupProgress" model="Model.Onboarding" />
<div class="stats"><div class="stat"><span>Branches</span><strong>@Model.Branches</strong><small class="muted">Locations in this workspace</small></div><div class="stat"><span>Menus</span><strong>@Model.Menus</strong><small class="muted">Menu experiences managed</small></div><div class="stat"><span>Products</span><strong>@Model.MenuItems</strong><small class="muted">Products across menus</small></div><div class="stat"><span>Active QR codes</span><strong>@Model.ActiveQrCodes</strong><small class="muted">Live guest entry points</small></div></div>
<section class="workspace-next surface"><div><span class="eyebrow">@UiText.Get("Next action")</span><h2>@(Model.Onboarding.IsComplete ? UiText.Get("Your restaurant is ready for daily management") : UiText.Get(Model.Onboarding.NextStepTitle))</h2><p class="muted">@(Model.Onboarding.IsComplete ? UiText.Get("Use the workspace shortcuts below to manage the live experience.") : UiText.Get(Model.Onboarding.NextStepDescription))</p></div><a class="btn btn-primary" href="@(tenantPath)/@Model.Onboarding.NextStepController/@Model.Onboarding.NextStepAction">@UiText.Get(Model.Onboarding.NextStepLabel)</a></section>
<section class="surface workspace-manage"><div class="section-heading"><div><span class="eyebrow">Manage</span><h2>Restaurant operations</h2></div></div><div class="action-row"><a class="btn btn-secondary" href="@(tenantPath)/Branches/Index">Branches</a><a class="btn btn-secondary" href="@(tenantPath)/Menus/Index">Menus</a><a class="btn btn-secondary" href="@(tenantPath)/Products/Index">Products</a><a class="btn btn-secondary" href="@(tenantPath)/Pricing/Index">Pricing</a><a class="btn btn-secondary" href="@(tenantPath)/QrCodes/Index">QR codes</a></div></section>
