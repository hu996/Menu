@model RestaurantMenuPlatform.Web.Models.LookupValueViewModel
@{ ViewData["Title"] = "Edit lookup value"; }
<div class="page-header"><div><span class="eyebrow">Configuration center</span><h1>Edit @Model.Code</h1></div><a class="text-link" asp-action="Index">Back to values</a></div>
@if (Model.IsGlobal && !User.IsInRole("PlatformAdmin"))
{
    <div class="notice-card"><strong>Global platform value</strong><p class="muted">This value is visible to tenants but can only be changed by the platform owner.</p></div>
}
else
{
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-stack premium-form narrow-form">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <section class="form-section"><div class="form-section-heading"><span class="eyebrow">System identity</span><h2>Controlled value</h2><p>Type and code remain read-only after creation to protect database references.</p></div><div class="form-grid"><div class="form-field"><label asp-for="Type"></label><input asp-for="Type" readonly /></div><div class="form-field"><label asp-for="Code"></label><input asp-for="Code" readonly /></div><div class="form-field"><label asp-for="SortOrder"></label><input asp-for="SortOrder" type="number" min="0" inputmode="numeric" /></div></div></section>
        <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Display</span><h2>Names & description</h2><p>Update operator-facing copy without changing the stable code.</p></div><div class="form-grid"><div class="form-field"><label asp-for="NameEn"></label><input asp-for="NameEn" /></div><div class="form-field"><label asp-for="NameAr"></label><input asp-for="NameAr" dir="rtl" /></div><div class="form-field form-field-full"><label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea></div></div></section>
        @Html.AntiForgeryToken()<div class="form-actions-sticky"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save value</button></div>
    </form>
}
