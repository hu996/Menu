@model RestaurantMenuPlatform.Web.Models.LookupValueViewModel
@{ ViewData["Title"] = "Add lookup value"; }
<div class="page-header"><div><span class="eyebrow">Configuration center</span><h1>Add lookup value</h1><p class="muted">Choose a controlled lookup type; arbitrary type strings are not accepted.</p></div><a class="text-link" asp-action="Index">Back to values</a></div>
<form asp-action="Create" method="post" class="form-stack premium-form narrow-form">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">System identity</span><h2>Controlled value</h2><p>The type and code identify how this value is used by the application.</p></div><div class="form-grid"><div class="form-field form-field-full"><label asp-for="Type"></label><select asp-for="Type"><option value="">Select an active lookup type</option>@foreach (var type in Model.Types) { <option value="@type.Code">@type.NameEn (@type.Code)</option> }</select><span asp-validation-for="Type" class="field-validation"></span></div><div class="form-field"><label asp-for="Code"></label><input asp-for="Code" placeholder="USD" /><span class="field-hint">Stable machine-readable code.</span><span asp-validation-for="Code" class="field-validation"></span></div><div class="form-field"><label asp-for="SortOrder"></label><input asp-for="SortOrder" type="number" min="0" inputmode="numeric" /></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Display</span><h2>Names & description</h2><p>Provide guest or operator-facing copy in the supported languages.</p></div><div class="form-grid"><div class="form-field"><label asp-for="NameEn"></label><input asp-for="NameEn" /></div><div class="form-field"><label asp-for="NameAr"></label><input asp-for="NameAr" dir="rtl" /></div><div class="form-field form-field-full"><label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea></div></div></section>
    @Html.AntiForgeryToken()<div class="form-actions-sticky"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Create value</button></div>
</form>
