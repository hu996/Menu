@model RestaurantMenuPlatform.Web.Models.IngredientViewModel
@{ ViewData["Title"] = "Edit ingredient"; }
<div class="page-header"><span class="eyebrow">Menu data</span><h1>Edit ingredient</h1></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-stack premium-form narrow-form"><div asp-validation-summary="ModelOnly" class="validation"></div><section class="form-section"><div class="form-section-heading"><span class="eyebrow">Catalog record</span><h2>Ingredient information</h2><p>Update reusable bilingual ingredient data for product disclosure.</p></div><div class="form-grid"><div class="form-field"><label asp-for="Name">English name</label><input asp-for="Name" /></div><div class="form-field"><label asp-for="NameAr">Arabic name</label><input asp-for="NameAr" dir="rtl" /></div></div></section>@Html.AntiForgeryToken()<div class="form-actions-sticky"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save changes</button></div></form>
