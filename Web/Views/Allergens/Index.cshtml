@model RestaurantMenuPlatform.Web.Models.AllergenIndexViewModel
@{ ViewData["Title"] = "Allergens"; }
<div class="page-header page-header-actions"><div><span class="eyebrow">Catalog</span><h1>Allergens</h1><p class="muted">Manage the disclosure vocabulary used by published menus.</p></div><a class="btn btn-primary" asp-action="Create">Add allergen</a></div>
<form method="get" class="filter-bar" aria-label="@UiText.Get("Allergen filters")">
    <label class="filter-field"><span>@UiText.Get("Search")</span><input type="search" name="search" value="@Model.Page.Search" placeholder="@UiText.Get("Search allergens")" /></label>
    <label class="filter-field"><span>@UiText.Get("Status")</span><select name="isActive"><option value="">@UiText.Get("All statuses")</option><option value="true" selected="@(Context.Request.Query["isActive"] == "true")">@UiText.Get("Active")</option><option value="false" selected="@(Context.Request.Query["isActive"] == "false")">@UiText.Get("Inactive")</option></select></label>
    <label class="filter-field"><span>@UiText.Get("Sort by")</span><select name="sortBy"><option value="name" selected="@(Context.Request.Query["sortBy"] == "name")">@UiText.Get("English name")</option><option value="arabic" selected="@(Context.Request.Query["sortBy"] == "arabic")">@UiText.Get("Arabic name")</option><option value="status" selected="@(Context.Request.Query["sortBy"] == "status")">@UiText.Get("Status")</option></select></label>
    <div class="filter-actions"><button class="btn btn-secondary" type="submit">@UiText.Get("Apply filters")</button><a class="btn btn-ghost" asp-action="Index">@UiText.Get("Reset")</a></div>
</form>
@if (Model.Page.Items.Count == 0) { <div class="empty-state"><span class="eyebrow">No allergens found</span><h2>Build your disclosure catalog.</h2><p class="muted">Add allergens before assigning them to menu products.</p><a class="btn btn-primary" asp-action="Create">Create allergen</a></div> }
else { <div class="data-table" data-columns="3"><div class="table-row table-heading"><span>@UiText.Get("Name")</span><span>@UiText.Get("Status")</span><span></span></div>@foreach (var item in Model.Page.Items) { <div class="table-row"><span>@UiText.Business(item.Name, item.Name, item.NameAr)</span><span class="status @(item.IsActive ? "status-live" : "status-muted")">@(item.IsActive ? UiText.Get("Active") : UiText.Get("Inactive"))</span><span><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">@UiText.Get("Edit")</a> <form asp-action="SetActive" method="post" class="inline-form" data-confirm data-confirm-title="@(item.IsActive ? "Deactivate allergen" : "Activate allergen")" data-confirm-message="@(item.IsActive ? "Deactivate this allergen? It will no longer be available for product disclosure." : "Activate this allergen for product disclosure?")" data-confirm-label="@(item.IsActive ? "Deactivate" : "Activate")" data-confirm-tone="@(item.IsActive ? "danger" : "warning")"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="isActive" value="@(!item.IsActive)" />@Html.AntiForgeryToken()<button class="text-link" type="submit">@(item.IsActive ? UiText.Get("Deactivate") : UiText.Get("Activate"))</button></form></span></div>}</div> }
@if (Model.Page.TotalPages > 1) { <nav class="pagination" aria-label="@UiText.Get("Allergen pages")">@for (var p = 1; p <= Model.Page.TotalPages; p++) { <a class="@(p == Model.Page.Page ? "active" : string.Empty)" aria-current="@(p == Model.Page.Page ? "page" : null)" asp-route-page="@p" asp-route-search="@Model.Page.Search" asp-route-isActive="@Context.Request.Query["isActive"]" asp-route-sortBy="@Context.Request.Query["sortBy"]">@p</a> }</nav> }
