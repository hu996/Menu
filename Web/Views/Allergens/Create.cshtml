@model RestaurantMenuPlatform.Web.Models.AllergenViewModel
@{ ViewData["Title"] = "Add allergen"; }
<div class="page-header"><span class="eyebrow">Catalog</span><h1>Add an allergen</h1></div>
<form asp-action="Create" method="post" class="form-stack narrow-form"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Name">English name</label><input asp-for="Name" /><label asp-for="NameAr">Arabic name</label><input asp-for="NameAr" dir="rtl" /><span asp-validation-for="Name" class="validation"></span>@Html.AntiForgeryToken()<button class="btn btn-primary" type="submit">Create allergen</button></form>
