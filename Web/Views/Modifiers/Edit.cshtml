@model RestaurantMenuPlatform.Web.Models.ModifierViewModel
@{ ViewData["Title"] = "Edit modifier"; }
<div class="page-header"><span class="eyebrow">Menu configuration</span><h1>Edit modifier group</h1><p class="muted">Keep selection rules and guest choices aligned with the current menu.</p></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-stack premium-form">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Group identity</span><h2>Modifier information</h2><p>Update the bilingual selection group and its required state.</p></div><div class="form-grid"><div class="form-field"><label asp-for="Name">English group name</label><input asp-for="Name" /></div><div class="form-field"><label asp-for="NameAr">Arabic group name</label><input asp-for="NameAr" dir="rtl" /></div><div class="form-field"><label class="checkbox-label"><input asp-for="IsRequired" /> <span>Selection is required</span></label></div><div class="form-field"><label class="checkbox-label"><input asp-for="IsActive" /> <span>Modifier group active</span></label></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Selection rules</span><h2>Choice limits</h2><p>Set the minimum and maximum selections enforced for this group.</p></div><div class="form-grid"><div class="form-field"><label asp-for="MinSelections"></label><input asp-for="MinSelections" type="number" min="0" inputmode="numeric" /></div><div class="form-field"><label asp-for="MaxSelections"></label><input asp-for="MaxSelections" type="number" min="0" inputmode="numeric" /></div></div></section>
    <fieldset class="form-section"><legend>Options</legend><div class="form-section-heading"><span class="eyebrow">Managed options</span><h2>Guest choices</h2><p>Each option has bilingual copy, a price adjustment, and an active state.</p></div>@for (var index = 0; index < Model.Options.Count; index++) { <div class="modifier-option-row"><div class="form-grid"><div class="form-field"><label asp-for="Options[index].Name">English option name</label><input asp-for="Options[index].Name" /></div><div class="form-field"><label asp-for="Options[index].NameAr">Arabic option name</label><input asp-for="Options[index].NameAr" dir="rtl" /></div><div class="form-field"><label asp-for="Options[index].PriceAdjustment">Price adjustment</label><input asp-for="Options[index].PriceAdjustment" type="number" step="0.01" inputmode="decimal" /></div><div class="form-field"><label class="checkbox-label"><input asp-for="Options[index].IsActive" /> <span>Active</span></label></div></div></div> }</fieldset>
    @Html.AntiForgeryToken()<div class="form-actions-sticky"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save changes</button></div>
</form>
