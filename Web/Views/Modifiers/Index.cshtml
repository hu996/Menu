@model RestaurantMenuPlatform.Web.Models.ModifierIndexViewModel
@{ ViewData["Title"] = "Modifiers"; }
<div class="page-header page-header-actions"><div><span class="eyebrow">Menu configuration</span><h1>Modifiers</h1><p class="muted">Manage optional selections and price adjustments for menu products.</p></div><a class="btn btn-primary" asp-action="Create">Add modifier</a></div>
<form method="get" class="filter-bar" aria-label="@UiText.Get("Modifier filters")">
    <label class="filter-field"><span>@UiText.Get("Search")</span><input type="search" name="search" value="@Model.Page.Search" placeholder="@UiText.Get("Search modifier groups")" /></label>
    <label class="filter-field"><span>@UiText.Get("Status")</span><select name="isActive"><option value="">@UiText.Get("All statuses")</option><option value="true" selected="@(Context.Request.Query["isActive"] == "true")">@UiText.Get("Active")</option><option value="false" selected="@(Context.Request.Query["isActive"] == "false")">@UiText.Get("Inactive")</option></select></label>
    <label class="filter-field"><span>@UiText.Get("Sort by")</span><select name="sortBy"><option value="name" selected="@(Context.Request.Query["sortBy"] == "name")">@UiText.Get("English name")</option><option value="arabic" selected="@(Context.Request.Query["sortBy"] == "arabic")">@UiText.Get("Arabic name")</option><option value="status" selected="@(Context.Request.Query["sortBy"] == "status")">@UiText.Get("Status")</option></select></label>
    <div class="filter-actions"><button class="btn btn-secondary" type="submit">@UiText.Get("Apply filters")</button><a class="btn btn-ghost" asp-action="Index">@UiText.Get("Reset")</a></div>
</form>
<div class="data-table" data-columns="5"><div class="table-row table-heading"><span>Group</span><span>Selection</span><span>Options</span><span>Status</span><span></span></div>@foreach (var item in Model.Page.Items) { <div class="table-row"><span><strong>@UiText.Business(item.Name, item.Name, item.NameAr)</strong></span><span>@(item.IsRequired ? UiText.Get("Required") : UiText.Get("Optional")) · @item.MinSelections–@item.MaxSelections</span><span>@string.Join(UiText.IsArabic ? "، " : ", ", item.Options.Where(x => x.IsActive).Select(x => $"{UiText.Business(x.Name, x.Name, x.NameAr)} ({x.PriceAdjustment:+0.00;-0.00;0.00})"))</span><span><span class="status @(item.IsActive ? "status-live" : "status-muted")">@(item.IsActive ? UiText.Get("Active") : UiText.Get("Inactive"))</span></span><span><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">@UiText.Get("Edit")</a> <form asp-action="SetActive" method="post" class="inline-form" data-confirm data-confirm-title="@(item.IsActive ? "Deactivate modifier group" : "Activate modifier group")" data-confirm-message="@(item.IsActive ? "Deactivate this modifier group? It will no longer be offered on the public menu." : "Activate this modifier group for public menus?")" data-confirm-label="@(item.IsActive ? "Deactivate" : "Activate")" data-confirm-tone="@(item.IsActive ? "danger" : "warning")"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="isActive" value="@(!item.IsActive)" />@Html.AntiForgeryToken()<button class="text-link" type="submit">@(item.IsActive ? UiText.Get("Deactivate") : UiText.Get("Activate"))</button></form></span></div>}</div>
@if (Model.Page.Items.Count == 0) { <div class="empty-state"><h2>No modifiers found.</h2><p class="muted">Create a modifier or change the search.</p></div> }
@if (Model.Page.TotalPages > 1) { <nav class="pagination" aria-label="@UiText.Get("Modifier pages")">@for (var pageNumber = 1; pageNumber <= Model.Page.TotalPages; pageNumber++) { <a class="@(pageNumber == Model.Page.Page ? "active" : null)" aria-current="@(pageNumber == Model.Page.Page ? "page" : null)" asp-action="Index" asp-route-page="@pageNumber" asp-route-search="@Model.Page.Search" asp-route-isActive="@Context.Request.Query["isActive"]" asp-route-sortBy="@Context.Request.Query["sortBy"]">@pageNumber</a> }</nav> }
