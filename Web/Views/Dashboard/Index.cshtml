@model RestaurantMenuPlatform.Application.DTOs.DashboardDto
@{
    ViewData["Title"] = "Dashboard";
    var tenantSlug = User.FindFirst("tenant_slug")?.Value ?? Context.Request.RouteValues["tenantSlug"]?.ToString();
    var tenantPath = string.IsNullOrWhiteSpace(tenantSlug) ? string.Empty : $"/r/{Uri.EscapeDataString(tenantSlug)}";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? UiText.Get("Viewer");
    var isArabic = string.Equals(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "ar", StringComparison.OrdinalIgnoreCase);
    var hasPermission = (string code) => User.IsInRole("PlatformAdmin") || User.IsInRole("TenantOwner") || User.IsInRole("TenantAdmin") || User.HasClaim("permission", code);
    var attention = (Model.Attention ?? Array.Empty<RestaurantMenuPlatform.Application.DTOs.DashboardAttentionDto>())
        .Where(item => string.IsNullOrWhiteSpace(item.RequiredPermission) || hasPermission(item.RequiredPermission!))
        .ToArray();
    var recentActivity = Model.RecentActivity ?? Array.Empty<RestaurantMenuPlatform.Application.DTOs.DashboardActivityDto>();

    var nextController = Model.Onboarding.NextStepController;
    var nextAction = Model.Onboarding.NextStepAction;
    var nextTitle = UiText.Get(Model.Onboarding.NextStepTitle);
    var nextDescription = UiText.Get(Model.Onboarding.NextStepDescription);
    var nextLabel = UiText.Get(Model.Onboarding.NextStepLabel);

    if (Model.Onboarding.IsComplete)
    {
        nextTitle = Model.PendingOrders > 0 && hasPermission("Orders.View")
            ? UiText.Get("Orders need attention")
            : Model.DraftMenus > 0 && hasPermission("Menu.View")
                ? UiText.Get("Draft menus are waiting")
                : UiText.Get("Review daily operations");
        nextDescription = Model.PendingOrders > 0 && hasPermission("Orders.View")
            ? UiText.Get("Review the newest orders and keep service moving.")
            : UiText.Get("Review the live workspace and keep the guest experience current.");
        if (Model.PendingOrders > 0 && hasPermission("Orders.View"))
        {
            nextController = "Orders";
            nextAction = "Index";
            nextLabel = UiText.Get("Orders");
        }
        else if (Model.DraftMenus > 0 && hasPermission("Menu.View"))
        {
            nextController = "Menus";
            nextAction = "Index";
            nextLabel = UiText.Get("Menus");
        }
        else if (hasPermission("Menu.View"))
        {
            nextController = "Menus";
            nextAction = "Index";
            nextLabel = UiText.Get("Open menus");
        }
        else
        {
            nextController = "Restaurant";
            nextAction = "Index";
            nextLabel = UiText.Get("Overview");
        }
    }
    else if (nextController == "Branches" && !hasPermission("Branch.Create"))
    {
        nextAction = "Index";
        nextLabel = UiText.Get("Branches");
    }
    else if (nextController == "Menus" && !hasPermission("Menu.Create"))
    {
        nextAction = "Index";
        nextLabel = UiText.Get("Menus");
    }
    else if (nextController == "Products" && !hasPermission("Product.Create"))
    {
        nextAction = "Index";
        nextLabel = UiText.Get("Products");
    }
    else if (nextController == "QrCodes" && !hasPermission("QR.Create"))
    {
        nextAction = "Index";
        nextLabel = UiText.Get("QR codes");
    }
}

<header class="dashboard-intro">
    <div>
        <span class="eyebrow">@UiText.Get("Restaurant command center")</span>
        <h1>@UiText.Business(Model.RestaurantName, Model.RestaurantName, Model.RestaurantNameAr)</h1>
        <p class="muted">@UiText.Get("Manage branches, menus, products, publishing, and daily readiness.")</p>
    </div>
    <div class="dashboard-context">
        <span class="context-chip"><small>@UiText.Get("Role")</small>@UiText.Get(role)</span>
    </div>
</header>

<section class="surface dashboard-health" aria-labelledby="health-title">
    <div class="health-summary">
        <span class="eyebrow">@UiText.Get("Operational status")</span>
        <h2 id="health-title">@(Model.Onboarding.IsComplete ? UiText.Get("Ready for daily operations") : UiText.Get("Setup in progress"))</h2>
        <p class="muted">@(Model.Onboarding.IsComplete ? UiText.Get("All core systems are configured and ready for service.") : UiText.Get("Complete the remaining saved setup steps before service begins."))</p>
    </div>
    <div class="health-signals">
        <span class="health-signal @(Model.Onboarding.RestaurantConfigured ? "is-ready" : "is-pending")"><span class="health-signal-dot" aria-hidden="true"></span>@UiText.Get("Restaurant")<strong>@(Model.Onboarding.RestaurantConfigured ? UiText.Get("Ready") : UiText.Get("Needs review"))</strong></span>
        <span class="health-signal @(Model.PublishedMenus > 0 ? "is-ready" : "is-pending")"><span class="health-signal-dot" aria-hidden="true"></span>@UiText.Get("Menus")<strong>@(Model.PublishedMenus > 0 ? UiText.Get("Published") : UiText.Get("Draft"))</strong></span>
        <span class="health-signal @(Model.ActiveQrCodes > 0 ? "is-ready" : "is-pending")"><span class="health-signal-dot" aria-hidden="true"></span>@UiText.Get("QR codes")<strong>@(Model.ActiveQrCodes > 0 ? UiText.Get("Active") : UiText.Get("Needs setup"))</strong></span>
    </div>
</section>

<section class="stats dashboard-kpis" aria-label="@UiText.Get("Key metrics")">
    <div class="stat"><span class="stat-icon" data-icon="map-pin" aria-hidden="true"></span><div class="stat-copy"><span>@UiText.Get("Branches")</span><strong>@Model.Branches</strong><small class="muted">@UiText.Get("Locations in this workspace")</small></div></div>
    <div class="stat"><span class="stat-icon" data-icon="book-open" aria-hidden="true"></span><div class="stat-copy"><span>@UiText.Get("Menus")</span><strong>@Model.Menus</strong><small class="muted">@Model.PublishedMenus @UiText.Get("published")</small></div></div>
    <div class="stat"><span class="stat-icon" data-icon="layers" aria-hidden="true"></span><div class="stat-copy"><span>@UiText.Get("Menu Items")</span><strong>@Model.MenuItems</strong><small class="muted">@UiText.Get("Products across menus")</small></div></div>
    <div class="stat"><span class="stat-icon" data-icon="qr-code" aria-hidden="true"></span><div class="stat-copy"><span>@UiText.Get("Active QR Codes")</span><strong>@Model.ActiveQrCodes</strong><small class="muted">@UiText.Get("Live guest entry points")</small></div></div>
    @if (hasPermission("Orders.View"))
    {
        <div class="stat stat-orders"><span class="stat-icon" data-icon="clipboard" aria-hidden="true"></span><div class="stat-copy"><span>@UiText.Get("Orders")</span><strong>@Model.PendingOrders</strong><small class="muted">@UiText.Get("Pending staff action")</small></div></div>
    }
</section>

<div class="dashboard-main-grid">
    <div class="dashboard-main-column">
        @if (attention.Length > 0)
        {
            <section class="surface dashboard-attention" aria-labelledby="attention-title">
                <div class="section-heading"><div><span class="eyebrow">@UiText.Get("Needs attention")</span><h2 id="attention-title">@UiText.Get("Keep the guest experience healthy")</h2><p class="muted">@UiText.Get("These live signals are based on the current restaurant workspace.")</p></div></div>
                <div class="attention-grid">
                    @foreach (var item in attention)
                    {
                        var localizedAttentionDescription = isArabic ? item.Key switch
                        {
                            "Orders" => $"{Model.PendingOrders} \u0637\u0644\u0628\u0627\u062a \u0645\u0639\u0644\u0642\u0629 \u062a\u0646\u062a\u0638\u0631 \u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646.",
                            "Menu drafts" => $"{Model.DraftMenus} \u0642\u0648\u0627\u0626\u0645 \u0645\u0633\u0648\u062f\u0629 \u064a\u0645\u0643\u0646 \u0645\u0631\u0627\u062c\u0639\u062a\u0647\u0627 \u0642\u0628\u0644 \u0627\u0644\u0646\u0634\u0631.",
                            "Availability" => item.Description.Replace("products are currently hidden from guests", "\u0645\u0646\u062a\u062c\u0627\u062a \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629 \u0644\u0644\u0636\u064a\u0648\u0641", StringComparison.Ordinal),
                            "Product media" => item.Description.Replace("products are missing a gallery image", "\u0645\u0646\u062a\u062c\u0627\u062a \u062a\u0641\u062a\u0642\u062f \u0635\u0648\u0631\u0629 \u0645\u0639\u0631\u0636", StringComparison.Ordinal),
                            "Publishing" => "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0644\u0636\u064a\u0648\u0641 \u0627\u0644\u0637\u0644\u0628 \u062d\u062a\u0649 \u064a\u062a\u0645 \u0646\u0634\u0631 \u0642\u0627\u0626\u0645\u0629 \u0648\u0627\u062d\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644.",
                            "Guest entry point" => "\u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0645\u0646\u0634\u0648\u0631\u0629 \u0644\u0643\u0646 \u0644\u0627 \u064a\u0648\u062c\u062f \u0631\u0645\u0632 QR \u0646\u0634\u0637 \u0644\u0644\u0636\u064a\u0648\u0641.",
                            _ => item.Description
                        } : item.Description;
                        <a class="attention-card tone-@item.Tone" href="@(tenantPath)/@item.Controller/@item.Action">
                            <span class="attention-card-key">@UiText.Get(item.Key)</span>
                            <strong>@UiText.Get(item.Title)</strong>
                            <span class="muted">@localizedAttentionDescription</span>
                            <span class="attention-card-link">@UiText.Get("Open") <span aria-hidden="true">→</span></span>
                        </a>
                    }
                </div>
            </section>
        }

        <section class="surface workspace-next" aria-labelledby="next-action-title">
            <div><span class="eyebrow">@UiText.Get("Next action")</span><h2 id="next-action-title">@nextTitle</h2><p class="muted">@nextDescription</p></div>
            <a class="btn btn-primary" href="@(tenantPath)/@nextController/@nextAction">@nextLabel <span aria-hidden="true">→</span></a>
        </section>

        @if (recentActivity.Count > 0 && hasPermission("Audit.View"))
        {
            <section class="surface dashboard-activity" aria-labelledby="activity-title">
                <div class="section-heading"><div><span class="eyebrow">@UiText.Get("Recent activity")</span><h2 id="activity-title">@UiText.Get("What changed recently")</h2></div><a class="btn btn-secondary" href="@(tenantPath)/Audit/Index">@UiText.Get("Open audit")</a></div>
                <div class="activity-list">
                    @foreach (var item in recentActivity)
                    {
                        <div class="activity-row"><span class="activity-dot" aria-hidden="true"></span><div><strong>@UiText.Get(item.Label)</strong><span class="muted">@item.EntityType · @(item.ActorDisplayName ?? UiText.Get("System"))</span></div><time datetime="@item.CreatedAtUtc.ToString("O")">@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</time></div>
                    }
                </div>
            </section>
        }

        @if (Model.AnalyticsEnabled && hasPermission("Analytics.View"))
        {
            <section id="analytics" class="surface analytics-summary">
                <div class="section-heading"><div><span class="eyebrow">@UiText.Get("Guest signals")</span><h2>@UiText.Get("Analytics")</h2><p class="muted">@UiText.Get("A focused view of how guests are discovering the published experience.")</p></div></div>
                <div class="analytics-stats">
                    <div><span>@UiText.Get("Total scans")</span><strong>@Model.Analytics.TotalScans</strong></div>
                    <div><span>@UiText.Get("Today's scans")</span><strong>@Model.Analytics.TodayScans</strong></div>
                    <div><span>@UiText.Get("Most viewed menu")</span><strong>@(Model.Analytics.MostViewedMenu is null ? UiText.Get("No views yet") : UiText.Business(Model.Analytics.MostViewedMenu.MenuName, Model.Analytics.MostViewedMenu.MenuName, Model.Analytics.MostViewedMenu.MenuNameAr))</strong></div>
                </div>
            </section>
        }
    </div>

    <aside class="dashboard-rail">
        <partial name="_SetupProgress" model="Model.Onboarding" />

        @if (hasPermission("Branch.Create") || hasPermission("Menu.Create") || hasPermission("Product.Create") || hasPermission("Pricing.View") || hasPermission("QR.View") || hasPermission("Orders.View"))
        {
            <section class="surface quick-actions" aria-labelledby="quick-actions-title">
                <div class="section-heading"><div><span class="eyebrow">@UiText.Get("Workspace shortcuts")</span><h2 id="quick-actions-title">@UiText.Get("Quick actions")</h2></div></div>
                <div class="quick-action-list">
                    @if (hasPermission("Branch.Create")) { <a href="@(tenantPath)/Branches/Create"><span data-icon="map-pin" aria-hidden="true"></span>@UiText.Get("Add branch")</a> }
                    @if (hasPermission("Menu.Create")) { <a href="@(tenantPath)/Menus/Create"><span data-icon="book-open" aria-hidden="true"></span>@UiText.Get("Create menu")</a> }
                    @if (hasPermission("Product.Create")) { <a href="@(tenantPath)/Products/Index"><span data-icon="layers" aria-hidden="true"></span>@UiText.Get("Create item")</a> }
                    @if (hasPermission("Pricing.View")) { <a href="@(tenantPath)/Pricing/Index"><span data-icon="tag" aria-hidden="true"></span>@UiText.Get("Pricing")</a> }
                    @if (hasPermission("QR.View")) { <a href="@(tenantPath)/QrCodes/Index"><span data-icon="qr-code" aria-hidden="true"></span>@UiText.Get("QR codes")</a> }
                    @if (hasPermission("Orders.View")) { <a href="@(tenantPath)/Orders/Index"><span data-icon="clipboard" aria-hidden="true"></span>@UiText.Get("Orders")</a> }
                </div>
            </section>
        }

        @if (Model.Entitlements is not null)
        {
            <section class="surface plan-summary" aria-labelledby="plan-title">
                <div><span class="eyebrow">@UiText.Get("Subscription")</span><h2 id="plan-title">@Model.Entitlements.PlanName</h2><p class="muted">@Model.Entitlements.Status · @(Model.Entitlements.IsActive ? UiText.Get("Active") : UiText.Get("Action required"))</p></div>
                <div class="plan-limits">
                    <span>@UiText.Get("Branches") <strong>@Model.Entitlements.BranchesUsed / @(Model.Entitlements.MaxBranches > 0 ? Model.Entitlements.MaxBranches : "∞")</strong></span>
                    <span>@UiText.Get("Menu Items") <strong>@Model.Entitlements.MenuItemsUsed / @(Model.Entitlements.MaxMenuItems > 0 ? Model.Entitlements.MaxMenuItems : "∞")</strong></span>
                    <span>@UiText.Get("Users") <strong>@Model.Entitlements.UsersUsed / @(Model.Entitlements.MaxUsers > 0 ? Model.Entitlements.MaxUsers : "∞")</strong></span>
                </div>
            </section>
        }
    </aside>
</div>
