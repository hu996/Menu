@model RestaurantMenuPlatform.Web.Models.LookupTypeViewModel
@{ ViewData["Title"] = "Add lookup type"; }
<div class="page-header"><div><span class="eyebrow">Configuration center</span><h1>Lookup type catalog</h1><p class="muted">Type identifiers are controlled by the platform so business services cannot receive an unhandled category. Manage database-backed values from the values grid.</p></div><a class="text-link" asp-action="Index">Back to types</a></div>
