@model RestaurantMenuPlatform.Web.Models.QrCodeManagementViewModel
@{
    ViewData["Title"] = UiText.Get("QR codes");
    var tenantSlug = Context.Request.RouteValues["tenantSlug"]?.ToString() ?? string.Empty;
    var cspNonce = Context.Items["CspNonce"]?.ToString();
}

<div class="page-header page-header-actions">
    <div><span class="eyebrow">@UiText.Get("Distribution")</span><h1>@UiText.Get("Table QR codes")</h1><p class="muted">@UiText.Get("Every operational QR resolves to one authoritative table at scan time.")</p></div>
    @if (Model.SelectedBranch is not null)
    {
        <a class="btn btn-secondary" asp-action="Print" asp-route-branchId="@Model.SelectedBranch.Id" target="_blank">@UiText.Get("Print table QR layout")</a>
    }
</div>
@if (Model.Branches.Count == 0)
{
    <div class="empty-state"><span class="eyebrow">@UiText.Get("No branches")</span><h2>@UiText.Get("Create a branch before generating QR codes.")</h2><a class="btn btn-primary" asp-controller="Branches" asp-action="Create">@UiText.Get("Create branch")</a></div>
}
else
{
    <section class="surface qr-management-panel">
        @if (Model.SelectedBranch is { IsActive: false })
        {
            <div class="feedback feedback-warning"><strong>@UiText.Get("Branch inactive.")</strong><span>@UiText.Get("Activate this branch before generating or using QR codes.")</span></div>
        }
        <form method="get" class="filter-bar" aria-label="@UiText.Get("QR filters")">
            <label class="filter-field" for="branchId"><span>@UiText.Get("Branch")</span><select id="branchId" name="branchId">@foreach (var branch in Model.Branches) { <option value="@branch.Id" selected="@(branch.Id == Model.BranchId)">@UiText.Business(branch.Name, branch.Name, branch.NameAr)</option> }</select></label>
            <div class="filter-actions"><button class="btn btn-secondary" type="submit">@UiText.Get("Load codes")</button></div>
        </form>
        <div class="notice-card"><strong>@UiText.Get("Table-specific issuance")</strong><p class="muted">@UiText.Get("Generate or reactivate a QR only from the database-backed table row below. Table labels are never accepted as a substitute for a real table.")</p><a class="text-link" href="/r/@tenantSlug/Tables/Index?branchId=@Model.BranchId">@UiText.Get("Manage tables")</a></div>
    </section>
    @if (Model.Codes.Count == 0)
    {
        <div class="empty-state"><h2>@UiText.Get("No QR codes for this branch yet.")</h2><p class="muted">@UiText.Get("Create an active table, then generate its QR below.")</p></div>
    }
    else
    {
        <div class="qr-card-grid">
        @foreach (var code in Model.Codes)
        {
            var assetUrl = Url.Action("Asset", "QrCodes", new { id = code.Id, format = "svg" });
            var tableLabel = code.TableName ?? code.TableLabel ?? UiText.Get("Legacy / unresolved");
            var isLegacy = code.TableId is null;
            <article class="detail-card qr-card">
                <div class="qr-card-preview"><img src="@assetUrl" alt="@UiText.Get("QR code for") @tableLabel" /></div>
                <div class="qr-card-copy">
                    <span class="eyebrow">@tableLabel</span>
                    <h2>@code.BranchName</h2>
                    <p class="muted">@code.RestaurantName</p>
                    @if (isLegacy)
                    {
                        <span class="status status-muted">@UiText.Get("Legacy / unresolved")</span>
                        <p class="field-hint">@UiText.Get("No table is attached. This QR cannot create a table-specific order.")</p>
                    }
                    else
                    {
                        <span class="status @(code.IsActive ? "status-live" : "status-muted")">@(code.IsActive ? UiText.Get("Active") : UiText.Get("Inactive"))</span>
                    }
                    <dl class="detail-list compact-detail-list">
                        <div><dt>@UiText.Get("Created")</dt><dd>@(code.CreatedAtUtc?.ToLocalTime().ToString("g") ?? UiText.Get("Unknown"))</dd></div>
                        <div><dt>@UiText.Get("Updated")</dt><dd>@(code.UpdatedAtUtc?.ToLocalTime().ToString("g") ?? UiText.Get("Not updated"))</dd></div>
                    </dl>
                    <code class="qr-url" data-copy-value="@code.TargetUrl">@code.TargetUrl</code>
                    <div class="action-row qr-actions">
                        <a class="text-link" asp-action="Details" asp-route-id="@code.Id">@UiText.Get("View details")</a>
                        <button type="button" class="btn btn-secondary" data-copy-target="@code.Id" data-copy-success="@UiText.Get("Link copied to clipboard.")" data-copy-error="@UiText.Get("Unable to copy link.")">@UiText.Get("Copy link")</button>
                        <a class="text-link" href="@Url.Action("Asset", "QrCodes", new { id = code.Id, format = "svg", download = true })">SVG</a>
                        <a class="text-link" href="@Url.Action("Asset", "QrCodes", new { id = code.Id, format = "png", download = true })">PNG</a>
                        @if (isLegacy)
                        {
                            @if (code.IsActive)
                            {
                                <form asp-action="SetActive" method="post" class="inline-form" data-confirm data-confirm-title="@UiText.Get("Deactivate unresolved QR")" data-confirm-message="@UiText.Get("Deactivate this legacy QR? It has no table and cannot create table-specific orders.")" data-confirm-label="@UiText.Get("Deactivate")" data-confirm-tone="danger">
                                    <input type="hidden" name="id" value="@code.Id" /><input type="hidden" name="isActive" value="false" />@Html.AntiForgeryToken()
                                    <button class="text-link danger-link" type="submit">@UiText.Get("Deactivate")</button>
                                </form>
                            }
                        }
                        else
                        {
                            <form asp-action="SetActive" method="post" class="inline-form" data-confirm data-confirm-title="@(code.IsActive ? UiText.Get("Deactivate QR code") : UiText.Get("Reactivate QR code"))" data-confirm-message="@(code.IsActive ? $"{UiText.Get("Deactivate QR for")} {tableLabel}{UiText.Get("Question mark")}" : $"{UiText.Get("Reactivate QR for")} {tableLabel}{UiText.Get("Question mark")}")" data-confirm-label="@(code.IsActive ? UiText.Get("Deactivate") : UiText.Get("Reactivate"))" data-confirm-tone="@(code.IsActive ? "danger" : "warning")">
                                <input type="hidden" name="id" value="@code.Id" /><input type="hidden" name="isActive" value="@(code.IsActive ? "false" : "true")" />@Html.AntiForgeryToken()
                                <button class="text-link @(code.IsActive ? "danger-link" : string.Empty)" type="submit">@(code.IsActive ? UiText.Get("Deactivate") : UiText.Get("Reactivate"))</button>
                            </form>
                        }
                    </div>
                </div>
            </article>
        }
        </div>
    }
    @if (Model.Tables.Count > 0)
    {
        <section class="surface">
            <div class="section-heading"><div><span class="eyebrow">@UiText.Get("Issuance")</span><h2>@UiText.Get("Table QR status")</h2></div></div>
            <div class="data-table-wrap"><table class="data-table"><thead><tr><th>@UiText.Get("Table")</th><th>@UiText.Get("Branch")</th><th>@UiText.Get("QR status")</th><th></th></tr></thead><tbody>
            @foreach (var table in Model.Tables)
            {
                var tableCode = Model.Codes.FirstOrDefault(x => x.TableId == table.Id);
                <tr>
                    <td data-label="@UiText.Get("Table")"><strong>@UiText.Business(table.Name, table.Name, table.NameAr)</strong></td>
                    <td data-label="@UiText.Get("Branch")">@table.BranchName</td>
                    <td data-label="@UiText.Get("QR status")">@if (tableCode is null) { <span class="status status-muted">@UiText.Get("Not issued")</span> } else { <span class="status @(tableCode.IsActive ? "status-live" : "status-muted")">@(tableCode.IsActive ? UiText.Get("Active") : UiText.Get("Inactive"))</span> }</td>
                    <td data-label="@UiText.Get("Actions")" class="action-row">
                        @if (tableCode is null)
                        {
                            <form asp-action="GenerateForTable" method="post" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="branchId" value="@table.BranchId" /><input type="hidden" name="tableId" value="@table.Id" /><button class="btn btn-secondary" type="submit" disabled="@(table.IsActive && Model.SelectedBranch?.IsActive == true ? null : "disabled")">@UiText.Get("Generate QR")</button></form>
                        }
                        else if (!tableCode.IsActive)
                        {
                            <form asp-action="SetActive" method="post" class="inline-form" data-confirm data-confirm-title="@UiText.Get("Reactivate QR code")" data-confirm-message="@UiText.Get("Reactivate QR for") @UiText.Business(table.Name, table.Name, table.NameAr)@UiText.Get("Question mark")" data-confirm-label="@UiText.Get("Reactivate")" data-confirm-tone="warning">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@tableCode.Id" /><input type="hidden" name="isActive" value="true" /><button class="btn btn-secondary" type="submit" disabled="@(table.IsActive && Model.SelectedBranch?.IsActive == true ? null : "disabled")">@UiText.Get("Reactivate")</button></form>
                        }
                        else
                        {
                            <a class="text-link" asp-action="Details" asp-route-id="@tableCode.Id">@UiText.Get("View QR")</a>
                        }
                    </td>
                </tr>
            }
            </tbody></table></div>
        </section>
    }
}
@section Scripts {
<script nonce="@cspNonce">
document.querySelectorAll('[data-copy-target]').forEach(button => button.addEventListener('click', async () => {
    const card = button.closest('.qr-card');
    const value = card?.querySelector('[data-copy-value]')?.dataset.copyValue;
    if (!value) return;
    try {
        await navigator.clipboard.writeText(value);
        window.MenuPlatform?.toast?.(button.dataset.copySuccess || 'Link copied.', { tone: 'success' });
    } catch {
        window.MenuPlatform?.toast?.(button.dataset.copyError || 'Unable to copy link.', { tone: 'danger' });
    }
}));
</script>
}
