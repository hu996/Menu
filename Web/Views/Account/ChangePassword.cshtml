@model RestaurantMenuPlatform.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="page-header"><span class="eyebrow">Account security</span><h1>Change password</h1><p class="muted">Use a unique password with at least 10 characters, uppercase, lowercase, number, and symbol.</p></div>
<form asp-action="ChangePassword" method="post" class="form-stack premium-form narrow-form">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Credentials</span><h2>Update password</h2><p>Use a unique password with at least 10 characters, uppercase, lowercase, number, and symbol.</p></div><div class="form-field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" /></div><div class="form-field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" type="password" autocomplete="new-password" /></div><div class="form-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /></div></section>
    @Html.AntiForgeryToken()<div class="form-actions-sticky"><button class="btn btn-primary" type="submit">Change password</button></div>
</form>
