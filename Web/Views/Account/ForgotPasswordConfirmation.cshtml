@model RestaurantMenuPlatform.Web.Models.ForgotPasswordConfirmationViewModel
@{
    ViewData["Title"] = "Reset requested";
}
<section class="auth-shell">
    <div class="auth-panel">
        <span class="eyebrow">Account recovery</span>
        <h1>Check your email.</h1>
        <p class="muted">If an account matches that address, a password reset message has been prepared.</p>
        @if (!string.IsNullOrWhiteSpace(Model.DevelopmentResetUrl))
        {
            <div class="success-banner">Development reset link: <a href="@Model.DevelopmentResetUrl">Continue securely</a></div>
        }
        <a class="text-link" asp-action="Login">Return to sign in</a>
    </div>
</section>
