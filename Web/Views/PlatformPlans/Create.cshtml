@model RestaurantMenuPlatform.Web.Models.PlanFormViewModel
@{ ViewData["Title"] = "Create plan"; }
<div class="page-header"><span class="eyebrow">Platform administration</span><h1>Create plan</h1><p class="muted">Limits are enforced server-side. Use zero for unlimited.</p></div>
<form asp-action="Create" method="post" class="form-stack premium-form">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Commercial identity</span><h2>Plan information</h2><p>Define the plan name and recurring price shown in the subscription catalog.</p></div><div class="form-grid"><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" /></div><div class="form-field"><label asp-for="MonthlyPrice"></label><input asp-for="MonthlyPrice" type="number" step="0.01" inputmode="decimal" /></div><div class="form-field"><label asp-for="Currency"></label><select asp-for="Currency"><option value="">Select currency</option>@foreach (var currency in Model.CurrencyOptions) { <option value="@currency.Code">@currency.NameEn (@currency.Code)</option> }</select></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Entitlements</span><h2>Usage limits</h2><p>Use zero for unlimited, as enforced by the platform entitlement service.</p></div><div class="form-grid"><div class="form-field"><label asp-for="MaxBranches"></label><input asp-for="MaxBranches" type="number" min="0" inputmode="numeric" /></div><div class="form-field"><label asp-for="MaxMenuItems"></label><input asp-for="MaxMenuItems" type="number" min="0" inputmode="numeric" /></div><div class="form-field"><label asp-for="MaxUsers"></label><input asp-for="MaxUsers" type="number" min="0" inputmode="numeric" /></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Capabilities</span><h2>Plan features</h2><p>Feature flags are persisted and evaluated by the subscription layer.</p></div><div class="form-grid"><div class="form-field"><label class="checkbox-label"><input asp-for="AdvancedAnalytics" /> <span>Advanced analytics</span></label></div><div class="form-field"><label class="checkbox-label"><input asp-for="CustomBranding" /> <span>Custom branding</span></label></div><div class="form-field"><label class="checkbox-label"><input asp-for="IsActive" /> <span>Available for new subscriptions</span></label></div><div class="form-field form-field-full"><label asp-for="FeaturesText"></label><textarea asp-for="FeaturesText" rows="8" placeholder="feature.key|true|optional numeric limit"></textarea><span class="field-hint">One database-backed feature per line.</span></div></div></section>
    @Html.AntiForgeryToken()<div class="form-actions-sticky"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Create plan</button></div>
</form>
