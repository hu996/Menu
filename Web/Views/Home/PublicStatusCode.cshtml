@using System.Globalization
@model RestaurantMenuPlatform.Web.Models.ErrorViewModel
@{
    Layout = null;
    var isArabic = string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "ar", StringComparison.OrdinalIgnoreCase);
    var title = isArabic ? "\u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629" : "Menu unavailable";
    var message = isArabic
        ? "\u0647\u0630\u0627 \u0627\u0644\u0631\u0627\u0628\u0637 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d \u062d\u0627\u0644\u064a\u0627\u064b. \u0642\u062f \u064a\u0643\u0648\u0646 \u0627\u0644\u0641\u0631\u0639 \u063a\u064a\u0631 \u0646\u0634\u0637 \u0623\u0648 \u0644\u0627 \u062a\u0648\u062c\u062f \u0642\u0627\u0626\u0645\u0629 \u0645\u0646\u0634\u0648\u0631\u0629 \u0644\u0647."
        : "This menu link is not currently available. The branch may be inactive or may not have a published menu.";
    var homeLabel = isArabic ? "\u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629" : "Return home";
}
<!doctype html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@title</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="public-menu-body">
    <main class="public-menu">
        <section class="error-state public-error-state">
            <span class="eyebrow">@Model.StatusCode</span>
            <h1>@title</h1>
            <p class="muted">@message</p>
            <a class="btn btn-primary" href="/">@homeLabel</a>
        </section>
    </main>
</body>
</html>
