@{
    ViewData["Title"] = "Restaurant Menu Platform";
}

<div class="hero">
    <span class="eyebrow">@UiText.Get("Restaurant operations platform")</span>
    <h1>@UiText.Get("Run every restaurant menu from one secure workspace.")</h1>
    <p>
        @UiText.Get("Publish bilingual digital menus, manage branches and tables, and keep guest orders moving in real time.")
    </p>
    <a class="btn btn-primary" asp-controller="Account" asp-action="Login">@UiText.Get("Sign in to your workspace")</a>
    <a class="btn btn-secondary" href="#platform-capabilities">@UiText.Get("Explore capabilities")</a>
</div>

<div class="grid" id="platform-capabilities">
    <div class="card"><strong>@UiText.Get("Bilingual guest experience")</strong><span>@UiText.Get("Switch complete screens between Arabic and English with matching menu content.")</span></div>
    <div class="card"><strong>@UiText.Get("Multi-branch control")</strong><span>@UiText.Get("Share menus across branches while keeping local pricing and availability under control.")</span></div>
    <div class="card"><strong>@UiText.Get("Table ordering")</strong><span>@UiText.Get("Issue secure table QR codes and move guest orders through the kitchen workflow.")</span></div>
    <div class="card"><strong>@UiText.Get("Commercial governance")</strong><span>@UiText.Get("Plans, permissions, audit history, and tenant isolation are enforced by the platform.")</span></div>
</div>
