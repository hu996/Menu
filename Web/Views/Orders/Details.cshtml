@model RestaurantMenuPlatform.Application.DTOs.StaffOrderDto
@using RestaurantMenuPlatform.Domain.Enums
@{ ViewData["Title"] = $"Order {Model.OrderNumber}"; var tenantSlug = Context.Request.RouteValues["tenantSlug"]?.ToString() ?? string.Empty; var next = Model.Status switch { "Pending" => new[] { OrderStatus.Accepted, OrderStatus.Rejected }, "Accepted" => new[] { OrderStatus.Preparing }, "Preparing" => new[] { OrderStatus.Ready }, "Ready" => new[] { OrderStatus.Completed }, _ => Array.Empty<OrderStatus>() }; var tableLabel = string.IsNullOrWhiteSpace(Model.TableName) ? "Not recorded" : Model.TableName; }
<div class="page-header page-header-actions"><div><span class="eyebrow">Order @Model.OrderNumber</span><h1>@Model.CustomerName</h1><p class="muted">@Model.CustomerPhone · @Model.BranchName · Table: @tableLabel</p></div><a class="btn btn-secondary" href="/r/@tenantSlug/Orders/Index">Back to orders</a></div>
<section class="surface detail-card"><div class="page-header"><div><span class="eyebrow">Current state</span><h2><span class="status" data-status="@Model.Status">@UiText.Get(Model.Status)</span></h2></div><strong class="metric-value">@Model.Total.ToString("0.00") @Model.Currency</strong></div>
@foreach (var item in Model.Items) { <div class="public-cart-line"><span>@item.Quantity x @item.ProductName @if (item.ModifierNames.Count > 0) { <small>@string.Join(", ", item.ModifierNames)</small> }</span><strong>@item.LineTotal.ToString("0.00") @item.Currency</strong></div> }
<div class="action-row">@foreach (var status in next) { <form action="/r/@tenantSlug/Orders/Transition" method="post" class="inline-form" data-confirm data-confirm-title="@UiText.Get("Confirm order status")" data-confirm-message="@(UiText.IsArabic ? $"تغيير حالة هذا الطلب إلى {UiText.Get(status.ToString())}؟" : $"Change this order to {status}?")" data-confirm-label="@UiText.Get(status.ToString())" data-confirm-tone="@(status == OrderStatus.Rejected ? "danger" : "warning")"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="@status" />@Html.AntiForgeryToken()<button class="btn @(status == OrderStatus.Rejected ? "btn-danger" : "btn-primary")" type="submit">@UiText.Get(status.ToString())</button></form> }</div></section>
