@model RestaurantMenuPlatform.Application.DTOs.StaffOrderDto
@using RestaurantMenuPlatform.Domain.Enums
@{ ViewData["Title"] = $"Order {Model.OrderNumber}"; var tenantSlug = Context.Request.RouteValues["tenantSlug"]?.ToString() ?? string.Empty; var next = Model.Status switch { "Pending" => new[] { OrderStatus.Accepted, OrderStatus.Rejected, OrderStatus.Cancelled }, "Accepted" => new[] { OrderStatus.Preparing, OrderStatus.Cancelled }, "Preparing" => new[] { OrderStatus.Ready, OrderStatus.Cancelled }, "Ready" => new[] { OrderStatus.Completed }, _ => Array.Empty<OrderStatus>() }; var tableLabel = string.IsNullOrWhiteSpace(Model.TableName) ? "Not recorded" : Model.TableName; }
<div class="page-header page-header-actions"><div><span class="eyebrow">Order @Model.OrderNumber</span><h1>@Model.CustomerName</h1><p class="muted">@Model.CustomerPhone · @Model.BranchName · Table: @tableLabel</p></div><div class="action-row"><a class="btn btn-secondary" href="/r/@tenantSlug/Orders/Print/@Model.Id" target="_blank">Print ticket</a><a class="btn btn-secondary" href="/r/@tenantSlug/Orders/Index">Back to orders</a></div></div>
<section class="surface detail-card"><div class="page-header"><div><span class="eyebrow">Current state</span><h2><span class="status" data-status="@Model.Status">@UiText.Get(Model.Status)</span></h2></div><strong class="metric-value">@Model.Total.ToString("0.00") @Model.Currency</strong></div>
@foreach (var item in Model.Items) { <div class="public-cart-line"><span>@item.Quantity x @item.ProductName @if (item.ModifierNames.Count > 0) { <small>@string.Join(", ", item.ModifierNames)</small> }</span><strong>@item.LineTotal.ToString("0.00") @item.Currency</strong></div> }
@if (!string.IsNullOrWhiteSpace(Model.Notes)) { <p class="field-hint"><strong>Guest notes:</strong> @Model.Notes</p> }
<div class="action-row">@foreach (var status in next) { var permission = status switch { OrderStatus.Accepted => "Orders.Accept", OrderStatus.Preparing => "Orders.Prepare", OrderStatus.Ready => "Orders.Ready", OrderStatus.Completed => "Orders.Complete", OrderStatus.Rejected => "Orders.Reject", OrderStatus.Cancelled => "Orders.Cancel", _ => string.Empty }; if (User.IsInRole("TenantOwner") || User.IsInRole("TenantAdmin") || User.HasClaim("permission", permission)) { <form action="/r/@tenantSlug/Orders/Transition" method="post" class="inline-form" data-confirm data-confirm-title="Confirm order status" data-confirm-message="Change this order to @status?" data-confirm-label="@UiText.Get(status.ToString())" data-confirm-tone="@(status is OrderStatus.Rejected or OrderStatus.Cancelled ? "danger" : "warning")"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="@status" />@Html.AntiForgeryToken()<button class="btn @(status is OrderStatus.Rejected or OrderStatus.Cancelled ? "btn-danger" : "btn-primary")" type="submit">@UiText.Get(status.ToString())</button></form> } }</div></section>
