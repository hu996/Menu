@model IReadOnlyList<RestaurantMenuPlatform.Application.DTOs.StaffOrderDto>
@{ ViewData["Title"] = "Orders"; var tenantSlug = Context.Request.RouteValues["tenantSlug"]?.ToString() ?? string.Empty; var branches = ViewBag.Branches as IReadOnlyList<RestaurantMenuPlatform.Application.DTOs.BranchDto> ?? Array.Empty<RestaurantMenuPlatform.Application.DTOs.BranchDto>(); var tables = ViewBag.Tables as IReadOnlyList<RestaurantMenuPlatform.Application.DTOs.RestaurantTableDto> ?? Array.Empty<RestaurantMenuPlatform.Application.DTOs.RestaurantTableDto>(); }
<div class="page-header page-header-actions"><div><span class="eyebrow">Operations</span><h1>Orders</h1><p class="muted">Branch-scoped guest orders, with table context when recorded.</p></div><a class="btn btn-primary" href="/r/@tenantSlug/Orders/Kitchen">Kitchen display</a></div>
<form method="get" class="surface filter-bar" aria-label="@UiText.Get("Order filters")">
    <label class="filter-field"><span>@UiText.Get("Search")</span><input type="search" name="search" value="@ViewBag.Search" placeholder="@UiText.Get("Order number, guest, or phone")" /></label>
    <label class="filter-field"><span>@UiText.Get("Branch")</span><select name="branchId"><option value="">@UiText.Get("All branches")</option>@foreach (var branch in branches) { <option value="@branch.Id" selected="@(branch.Id == (Guid?)ViewBag.BranchId)">@branch.Name</option> }</select></label>
    <label class="filter-field"><span>@UiText.Get("Table")</span><select name="tableId"><option value="">@UiText.Get("All tables")</option>@foreach (var table in tables) { <option value="@table.Id" selected="@(table.Id == (Guid?)ViewBag.TableId)">@table.Name</option> }</select></label>
    <label class="filter-field"><span>@UiText.Get("Status")</span><select name="status"><option value="">@UiText.Get("All statuses")</option>@foreach (var value in Enum.GetNames<RestaurantMenuPlatform.Domain.Enums.OrderStatus>()) { <option value="@value" selected="@(string.Equals(value, (string)ViewBag.Status, StringComparison.OrdinalIgnoreCase))">@UiText.Get(value)</option> }</select></label>
    <label class="filter-field"><span>@UiText.Get("Date from")</span><input type="date" name="dateFrom" value="@ViewBag.DateFrom" /></label>
    <label class="filter-field"><span>@UiText.Get("Date to")</span><input type="date" name="dateTo" value="@ViewBag.DateTo" /></label>
    <div class="filter-actions"><button class="btn btn-secondary" type="submit">@UiText.Get("Apply filters")</button><a class="btn btn-ghost" asp-action="Index">@UiText.Get("Reset")</a></div>
</form>
@if (Model.Count == 0)
{ <div class="empty-state"><span class="eyebrow">No orders yet</span><h2>New guest orders will appear here.</h2></div> }
else
{
    <div class="data-table-wrap"><table class="data-table"><thead><tr><th>Order</th><th>Table</th><th>Guest</th><th>Items</th><th>Total</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody>
    @foreach (var order in Model)
    { <tr><td data-label="@UiText.Get("Order")"><strong>@order.OrderNumber</strong></td><td data-label="@UiText.Get("Table")">@(order.TableName ?? UiText.Get("Not recorded"))</td><td data-label="@UiText.Get("Guest")">@order.CustomerName<br /><small>@order.CustomerPhone</small></td><td data-label="@UiText.Get("Items")">@order.Items.Sum(x => x.Quantity)</td><td data-label="@UiText.Get("Total")">@order.Total.ToString("0.00") @order.Currency</td><td data-label="@UiText.Get("Status")"><span class="status" data-status="@order.Status">@UiText.Get(order.Status)</span></td><td data-label="@UiText.Get("Created")">@order.CreatedAtUtc.ToLocalTime().ToString("g")</td><td data-label="@UiText.Get("Actions")"><a class="text-link" href="/r/@tenantSlug/Orders/Details/@order.Id">@UiText.Get("Open")</a></td></tr> }
    </tbody></table></div>
}
