@model RestaurantMenuPlatform.Application.DTOs.StaffOrderDto
@{ Layout = null; var isArabic = UiText.IsArabic; var language = isArabic ? "ar" : "en"; var table = string.IsNullOrWhiteSpace(Model.TableName) ? UiText.Get("No table") : $"{UiText.Get("Table")} {UiText.Business(Model.TableName, Model.TableName, Model.TableNameAr)}"; var cspNonce = Context.Items["CspNonce"]?.ToString(); }
<!doctype html><html lang="@language" dir="@(isArabic ? "rtl" : "ltr")"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@UiText.Get("Order") @Model.OrderNumber</title><style>body{font-family:Arial,sans-serif;width:320px;margin:0 auto;padding:18px;color:#171a18}h1{font-size:24px;margin:0 0 4px}h2{font-size:16px;margin:20px 0 8px;border-bottom:1px solid #ddd;padding-bottom:6px}.muted{color:#68736c;font-size:12px}.line{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px dashed #ddd}.note{border:1px solid #ddd;padding:10px;margin-top:14px;font-size:13px}@@media print{body{width:auto;margin:0;padding:8px}}</style></head><body><h1>@Model.OrderNumber</h1><div class="muted">@table · @Model.BranchName</div><div class="muted">@Model.CustomerName · @Model.CustomerPhone</div><h2>@UiText.Get("Items")</h2>@foreach (var item in Model.Items) { <div class="line"><span>@item.Quantity × @item.ProductName@if(item.ModifierNames.Count > 0){<br /><small>@string.Join(isArabic ? "، " : ", ", item.ModifierNames)</small>}</span><strong>@item.LineTotal.ToString("0.00") @item.Currency</strong></div> }@if (!string.IsNullOrWhiteSpace(Model.Notes)){<div class="note"><strong>@UiText.Get("Guest note")</strong><br />@Model.Notes</div>}<h2>@UiText.Get("Total") <span style="float:@(isArabic ? "left" : "right")">@Model.Total.ToString("0.00") @Model.Currency</span></h2><script nonce="@cspNonce">window.print();</script></body></html>
