@model RestaurantMenuPlatform.Web.Models.MenuCategoryViewModel
@{ ViewData["Title"] = "Edit category"; }
<div class="page-header"><span class="eyebrow">Menu studio</span><h1>Edit category</h1><p class="muted">Keep category hierarchy and ordering clear for guests.</p></div>
<form asp-action="EditCategory" asp-route-id="@Context.Request.RouteValues["id"]" method="post" class="form-stack premium-form narrow-form">
    <input asp-for="MenuId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Identity</span><h2>Category information</h2><p>Update guest-facing copy without changing the menu it belongs to.</p></div><div class="form-grid"><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" /></div><div class="form-field"><label asp-for="NameAr"></label><input asp-for="NameAr" dir="rtl" /></div><div class="form-field"><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea></div><div class="form-field"><label asp-for="DescriptionAr"></label><textarea asp-for="DescriptionAr" rows="3" dir="rtl"></textarea></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Structure</span><h2>Classification & order</h2><p>Choose the existing classification and parent records.</p></div><div class="form-grid"><div class="form-field"><label asp-for="ClassificationCode"></label><select asp-for="ClassificationCode"><option value="">Select classification</option>@foreach (var option in Model.Classifications) { <option value="@option.Code">@UiText.Business(option.NameEn, option.NameEn, option.NameAr)</option> }</select></div><div class="form-field"><label asp-for="ParentCategoryId"></label><select asp-for="ParentCategoryId"><option value="">Top-level category</option>@foreach (var category in Model.ParentCategories) { <option value="@category.Id">@UiText.Business(category.Name, category.Name, category.NameAr)</option> }</select></div><div class="form-field"><label asp-for="SortOrder"></label><input asp-for="SortOrder" type="number" inputmode="numeric" /></div></div></section>
    @Html.AntiForgeryToken()<div class="form-actions-sticky"><a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.MenuId">Cancel</a><button class="btn btn-primary" type="submit">Save category</button></div>
</form>
