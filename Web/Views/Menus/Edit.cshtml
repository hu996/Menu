@model RestaurantMenuPlatform.Web.Models.MenuViewModel
@{ ViewData["Title"] = "Edit menu"; var tenantSlug = User.FindFirst("tenant_slug")?.Value ?? Context.Request.RouteValues["tenantSlug"]?.ToString(); var tenantPath = string.IsNullOrWhiteSpace(tenantSlug) ? string.Empty : $"/r/{Uri.EscapeDataString(tenantSlug)}"; }
<div class="page-header"><span class="eyebrow">Menu studio</span><h1>Edit @Model.Name</h1><p class="muted">The menu address remains /@Model.Slug.</p></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-stack premium-form">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    @if (ViewData["EntitlementError"] is string entitlementError)
    {
        <section class="business-rule-feedback" role="alert"><strong>@UiText.Get("Plan limit reached")</strong><p>@UiText.Feedback(entitlementError)</p><a class="btn btn-secondary" href="@(tenantPath)/Billing/Index">@UiText.Get("Review plans")</a></section>
    }
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Identity</span><h2>Menu information</h2><p>Keep the bilingual title and guest introduction aligned.</p></div><div class="form-grid"><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="field-validation"></span></div><div class="form-field"><label asp-for="NameAr"></label><input asp-for="NameAr" dir="rtl" /></div><div class="form-field"><label asp-for="Description"></label><textarea asp-for="Description" rows="3"></textarea></div><div class="form-field"><label asp-for="DescriptionAr"></label><textarea asp-for="DescriptionAr" rows="3" dir="rtl"></textarea></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Classification</span><h2>Menu behavior</h2><p>Use the existing lookup values to control type and branch scope.</p></div><div class="form-grid"><div class="form-field"><label asp-for="MenuTypeCode"></label><select asp-for="MenuTypeCode"><option value="">Select from database</option>@foreach (var option in Model.MenuTypes) { <option value="@option.Code">@UiText.Business(option.NameEn, option.NameEn, option.NameAr)</option> }</select></div><div class="form-field"><label asp-for="ScopeCode"></label><select asp-for="ScopeCode"><option value="">Select from database</option>@foreach (var option in Model.MenuScopes) { <option value="@option.Code">@UiText.Business(option.NameEn, option.NameEn, option.NameAr)</option> }</select></div><div class="form-field"><label asp-for="SortOrder"></label><input asp-for="SortOrder" type="number" inputmode="numeric" /></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Presentation</span><h2>Menu palette</h2><p>Colors are applied to the public menu presentation.</p></div>@if (Model.CanCustomizeBranding) { <div class="form-grid"><div class="form-field"><label asp-for="BrandPrimaryColor"></label><input asp-for="BrandPrimaryColor" type="color" /></div><div class="form-field"><label asp-for="BrandAccentColor"></label><input asp-for="BrandAccentColor" type="color" /></div></div> } else { <p class="field-hint">Custom menu colors are available on plans that include custom branding. The restaurant defaults remain active.</p> }</section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Distribution</span><h2>Selected branches</h2><p>For an all-branches scope, every active branch is assigned automatically. For a selected-branches scope, choose the locations below.</p></div><div class="choice-list">@foreach (var branch in Model.Branches) { <label class="choice-list-item"><input type="checkbox" name="BranchIds" value="@branch.Id" @(Model.BranchIds.Contains(branch.Id) ? "checked" : null) /><span>@branch.Name<small>Branch menu assignment</small></span></label> }</div></section>
    <input asp-for="IsGlobal" type="hidden" />
    @Html.AntiForgeryToken()
    <div class="form-actions-sticky"><a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="btn btn-primary" type="submit">Save menu</button></div>
</form>
