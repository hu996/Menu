@model RestaurantMenuPlatform.Web.Models.MenuItemViewModel
@{ ViewData["Title"] = "Add item"; var tenantSlug = User.FindFirst("tenant_slug")?.Value ?? Context.Request.RouteValues["tenantSlug"]?.ToString(); var tenantPath = string.IsNullOrWhiteSpace(tenantSlug) ? string.Empty : $"/r/{Uri.EscapeDataString(tenantSlug)}"; }
<div class="page-header"><span class="eyebrow">Menu studio</span><h1>Add a menu item</h1><p class="muted">Create the product record first, then refine availability and imagery in the product editor.</p></div>
<form asp-action="CreateItem" method="post" class="form-stack premium-form">
    <input asp-for="CategoryId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div>
    @if (ViewData["EntitlementError"] is string entitlementError)
    {
        <section class="business-rule-feedback" role="alert"><strong>@UiText.Get("Plan limit reached")</strong><p>@UiText.Feedback(entitlementError)</p><a class="btn btn-secondary" href="@(tenantPath)/Billing/Index">@UiText.Get("Review plans")</a></section>
    }
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Product</span><h2>Basic information</h2><p>Use clear bilingual copy that works at a glance on the public menu.</p></div><div class="form-grid"><div class="form-field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="field-validation"></span></div><div class="form-field"><label asp-for="NameAr"></label><input asp-for="NameAr" dir="rtl" /></div><div class="form-field"><label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea></div><div class="form-field"><label asp-for="DescriptionAr"></label><textarea asp-for="DescriptionAr" rows="4" dir="rtl"></textarea></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Classification & pricing</span><h2>Commercial details</h2><p>Choose values from the database-backed product and currency lookups.</p></div><div class="form-grid"><div class="form-field"><label asp-for="ProductTypeCode"></label><select asp-for="ProductTypeCode"><option value="">Select product type</option>@foreach (var type in Model.ProductTypes) { <option value="@type.Code">@type.NameEn</option> }</select></div><div class="form-field"><label asp-for="Price"></label><input asp-for="Price" type="number" step="0.01" inputmode="decimal" /></div><div class="form-field"><label asp-for="Currency"></label><select asp-for="Currency"><option value="">Select currency</option>@foreach (var currency in Model.CurrencyOptions) { <option value="@currency.Code">@currency.NameEn (@currency.Code)</option> }</select></div><div class="form-field"><label asp-for="SortOrder"></label><input asp-for="SortOrder" type="number" inputmode="numeric" /></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Managed associations</span><h2>Ingredients, allergens & modifiers</h2><p>Select existing tenant records. Create new records in their catalog sections.</p></div><div class="form-grid"><fieldset class="form-field"><legend>Ingredients</legend><div class="choice-list">@foreach (var ingredient in Model.IngredientOptions) { <label class="choice-list-item"><input type="checkbox" name="IngredientIds" value="@ingredient.Id" /><span>@ingredient.Name<small>Managed ingredient</small></span></label> }</div></fieldset><fieldset class="form-field"><legend>Allergens</legend><div class="choice-list">@foreach (var allergen in Model.AllergenOptions) { <label class="choice-list-item"><input type="checkbox" name="AllergenIds" value="@allergen.Id" /><span>@allergen.Name<small>Public disclosure</small></span></label> }</div></fieldset><fieldset class="form-field form-field-full"><legend>Modifiers / extras</legend><div class="choice-list">@foreach (var modifier in Model.Modifiers) { <label class="choice-list-item"><input type="checkbox" name="ModifierIds" value="@modifier.Id" /><span>@modifier.Name<small>Optional or required selection group</small></span></label> }</div></fieldset></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Media & display</span><h2>Product presentation</h2><p>Save the product first, then add real product images from its managed gallery.</p></div><p class="field-hint">Product images are uploaded from the product editor after creation. External image URLs are not accepted for managed product media.</p></section>
    @Html.AntiForgeryToken()<div class="form-actions-sticky"><a class="btn btn-secondary" href="@(tenantPath)/Menus/Index">Cancel</a><button class="btn btn-primary" type="submit">Create item</button></div>
</form>
