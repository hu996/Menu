@model RestaurantMenuPlatform.Web.Models.UserEditViewModel
@{ ViewData["Title"] = "Edit user"; var restaurantName = User.FindFirst("tenant_name")?.Value ?? User.FindFirst("tenant_slug")?.Value ?? "Current restaurant"; }
<div class="page-header"><span class="eyebrow">People & access</span><h1>Edit membership</h1><p class="muted">Update access for <strong>@Model.Email</strong> inside <strong>@restaurantName</strong>.</p></div>
<div class="context-card"><span class="eyebrow">Restaurant context</span><strong>@restaurantName</strong><p class="muted">Membership IDs are resolved inside the current tenant; cross-restaurant IDs are rejected.</p></div>
<form asp-action="Edit" method="post" class="form-stack premium-form narrow-form">
    <input type="hidden" asp-for="MembershipId" /><div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Profile</span><h2>User information</h2></div><div class="form-grid"><div class="form-field"><label asp-for="DisplayName"></label><input asp-for="DisplayName" autocomplete="name" /></div><div class="form-field"><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" /></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Membership</span><h2>Role & branch scope</h2></div><div class="form-grid"><div class="form-field"><label asp-for="Role"></label><select asp-for="Role"><option value="TenantAdmin">Tenant admin</option><option value="BranchManager">Branch manager</option><option value="MenuEditor">Menu editor</option><option value="Viewer">Viewer</option></select></div><div class="form-field"><label asp-for="BranchId">Branch scope</label><select asp-for="BranchId"><option value="">All branches / not applicable</option>@foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }</select></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Access control</span><h2>Direct permissions</h2><p>Changing role or permissions invalidates the member’s existing session.</p></div><div class="permission-groups">@foreach (var group in Model.PermissionOptions.GroupBy(x => x.GroupCode).OrderBy(x => x.Key)) { <fieldset class="permission-group"><legend>@group.Key</legend><div class="permission-grid">@foreach (var permission in group.OrderBy(x => x.SortOrder)) { <label class="permission-option"><input type="checkbox" name="PermissionCodes" value="@permission.Code" checked="@(Model.PermissionCodes.Contains(permission.Code) ? "checked" : null)" /><span><strong>@permission.NameEn</strong><small>@permission.Code · @permission.NameAr</small></span></label> }</div></fieldset> }</div></section>
    @Html.AntiForgeryToken()<div class="form-actions-sticky"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save membership</button></div>
</form>
