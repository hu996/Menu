@model RestaurantMenuPlatform.Web.Models.UserCreateViewModel
@{ ViewData["Title"] = "Add user"; var restaurantName = User.FindFirst("tenant_name")?.Value ?? User.FindFirst("tenant_slug")?.Value ?? "Current restaurant"; }
<div class="page-header"><span class="eyebrow">People & access</span><h1>Add user</h1><p class="muted">Create a membership inside <strong>@restaurantName</strong>. Restaurant ownership is resolved by the authenticated session.</p></div>
<div class="context-card"><span class="eyebrow">Restaurant context</span><strong>@restaurantName</strong><p class="muted">There is no restaurant selector here. The server scopes this operation to the current tenant.</p></div>
<form asp-action="Create" method="post" class="form-stack premium-form narrow-form">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Profile</span><h2>User information</h2><p>Use the operator’s working identity and email address.</p></div><div class="form-grid"><div class="form-field"><label asp-for="DisplayName"></label><input asp-for="DisplayName" autocomplete="name" /></div><div class="form-field"><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" /></div><div class="form-field form-field-full"><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="new-password" /><span class="field-hint">Use at least 10 characters with upper/lowercase letters, a number, and a symbol.</span></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Membership</span><h2>Role & branch scope</h2><p>Role presets are enforced server-side; direct grants below are persisted to this membership.</p></div><div class="form-grid"><div class="form-field"><label asp-for="Role"></label><select asp-for="Role"><option value="TenantAdmin">Tenant admin</option><option value="BranchManager">Branch manager</option><option value="Kitchen">Kitchen</option><option value="Waiter">Waiter</option><option value="MenuEditor">Menu editor</option><option value="Viewer">Viewer</option></select></div><div class="form-field"><label asp-for="BranchId">Branch scope</label><select asp-for="BranchId"><option value="">All branches / not applicable</option>@foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }</select><span class="field-hint">Branch managers, kitchen staff, and waiters must be limited to an assigned location.</span></div></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Access control</span><h2>Direct permissions</h2><p>Assign only what this person needs. Role permissions remain visible in the policy layer.</p></div><div class="permission-groups">@foreach (var group in Model.PermissionOptions.GroupBy(x => x.GroupCode).OrderBy(x => x.Key)) { <fieldset class="permission-group"><legend>@UiText.Get(group.Key)</legend><div class="permission-grid">@foreach (var permission in group.OrderBy(x => x.SortOrder)) { <label class="permission-option"><input type="checkbox" name="PermissionCodes" value="@permission.Code" checked="@(Model.PermissionCodes.Contains(permission.Code) ? "checked" : null)" /><span><strong>@UiText.Business(permission.NameEn, permission.NameEn, permission.NameAr)</strong><small>@permission.Code</small></span></label> }</div></fieldset> }</div></section>
    @Html.AntiForgeryToken()<div class="form-actions-sticky"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Create membership</button></div>
</form>
