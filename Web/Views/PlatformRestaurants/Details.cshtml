@model RestaurantMenuPlatform.Web.Models.PlatformRestaurantDetailsViewModel
@{ var restaurant = Model.Details.Restaurant; ViewData["Title"] = restaurant.Name; }

<div class="page-header page-header-actions"><div><span class="eyebrow">@UiText.Get("Platform restaurant")</span><h1>@UiText.Business(restaurant.Name, restaurant.Name, restaurant.NameAr)</h1><p class="muted">/@restaurant.Slug · @restaurant.PlanName · @restaurant.Status</p></div><a class="btn btn-secondary" asp-action="Index">@UiText.Get("Back to restaurants")</a></div>

<section class="stats"><div class="stat"><span>@UiText.Get("Owner")</span><strong>@(restaurant.OwnerName ?? UiText.Get("Unassigned"))</strong><small class="muted">@(restaurant.OwnerEmail ?? UiText.Get("No owner email"))</small></div><div class="stat"><span>@UiText.Get("Branches")</span><strong>@restaurant.Branches</strong><small class="muted">@UiText.Get("Operational branches")</small></div><div class="stat"><span>@UiText.Get("Menus")</span><strong>@restaurant.Menus</strong><small class="muted">@UiText.Get("Saved menus")</small></div><div class="stat"><span>@UiText.Get("Products")</span><strong>@restaurant.Products</strong><small class="muted">@UiText.Get("Saved products")</small></div></section>

<div class="dashboard-grid">
    <section class="surface"><div class="section-heading"><div><span class="eyebrow">@UiText.Get("Access")</span><h2>@UiText.Get("Owner membership")</h2></div><span class="status @(restaurant.IsActive ? "status-live" : "status-muted")">@(restaurant.IsActive ? UiText.Get("Active") : UiText.Get("Inactive"))</span></div><p class="muted">@UiText.Get("The owner is assigned to this restaurant with the TenantOwner role. Operational setup remains in the tenant workspace.")</p></section>
    <section class="surface"><div class="section-heading"><div><span class="eyebrow">@UiText.Get("Lifecycle")</span><h2>@UiText.Get("Subscription history")</h2></div></div>@if (Model.Details.SubscriptionHistory.Count == 0) { <p class="muted">@UiText.Get("No subscription history found.")</p> } else { <div class="data-table" data-columns="2">@foreach (var subscription in Model.Details.SubscriptionHistory) { <div class="table-row"><span><strong>@subscription.PlanName</strong><small>@subscription.StartsAtUtc.ToLocalTime().ToString("g")</small></span><span>@subscription.Status</span></div> }</div> }</section>
</div>

<section class="surface form-actions"><div><span class="eyebrow">@UiText.Get("Status")</span><h2>@(restaurant.IsActive ? UiText.Get("Restaurant is operational") : UiText.Get("Restaurant access is paused"))</h2><p class="muted">@(restaurant.IsActive ? UiText.Get("Owner access is available according to membership and plan rules.") : UiText.Get("Owner access is blocked until the platform reactivates this restaurant."))</p></div><form asp-action="SetActive" method="post" class="inline-form" data-confirm data-confirm-title="@(restaurant.IsActive ? UiText.Get("Deactivate restaurant") : UiText.Get("Activate restaurant"))" data-confirm-message="@(restaurant.IsActive ? UiText.Get("Pause access for this restaurant?") : UiText.Get("Restore access for this restaurant?"))" data-confirm-label="@(restaurant.IsActive ? UiText.Get("Deactivate") : UiText.Get("Activate"))" data-confirm-tone="@(restaurant.IsActive ? "danger" : "warning")"><input type="hidden" name="id" value="@restaurant.Id" /><input type="hidden" name="isActive" value="@(!restaurant.IsActive)" />@Html.AntiForgeryToken()<button class="btn @(restaurant.IsActive ? "btn-danger" : "btn-primary")" type="submit">@(restaurant.IsActive ? UiText.Get("Deactivate") : UiText.Get("Activate"))</button></form></section>
