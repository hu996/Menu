@model RestaurantMenuPlatform.Application.DTOs.BillingOverviewDto
@{
    ViewData["Title"] = "Plans & billing";
    var tenantSlug = User.FindFirst("tenant_slug")?.Value ?? Context.Request.RouteValues["tenantSlug"]?.ToString();
    var tenantPath = string.IsNullOrWhiteSpace(tenantSlug) ? string.Empty : $"/r/{Uri.EscapeDataString(tenantSlug)}";
}

<div class="page-header">
    <div><span class="eyebrow">@UiText.Get("Commercial workspace")</span><h1>@UiText.Get("Plans & billing")</h1><p class="muted">@UiText.Get("Database-backed plans, entitlements, subscriptions, and payment history.")</p></div>
</div>

@if (Model.CurrentSubscription is not null)
{
    <section class="surface plan-summary">
        <div><span class="eyebrow">Current subscription</span><h2>@Model.CurrentSubscription.PlanName</h2><p class="muted">@Model.CurrentSubscription.Status · Started @Model.CurrentSubscription.StartsAtUtc.ToLocalTime().ToString("dd MMM yyyy")</p></div>
        <div class="action-row"><div class="status" data-status="@Model.CurrentSubscription.Status">@UiText.Get(Model.CurrentSubscription.Status.ToString())</div><form action="@(tenantPath)/Billing/CancelSubscription" method="post" class="inline-form" data-confirm data-confirm-title="Cancel subscription" data-confirm-message="Cancel the current subscription? Access remains available until the provider confirms the effective end date, and no further renewal should be scheduled." data-confirm-label="Cancel subscription" data-confirm-tone="danger">@Html.AntiForgeryToken()<button class="btn btn-danger" type="submit">Cancel subscription</button></form></div>
    </section>
}
else
{
    <div class="empty-state"><h2>No subscription is assigned.</h2><p class="muted">A plan must be assigned before tenant limits can be enforced.</p></div>
}

@if (Model.CurrentEntitlement is not null)
{
    <section class="surface entitlement-overview" aria-labelledby="entitlement-title">
        <div class="section-heading"><div><span class="eyebrow">@UiText.Get("Current usage")</span><h2 id="entitlement-title">@Model.CurrentEntitlement.PlanName</h2><p class="muted">@UiText.Get("Limits are enforced server-side before a new record is created.")</p></div><span class="status @(Model.CurrentEntitlement.IsActive ? "status-live" : "status-muted")">@Model.CurrentEntitlement.Status</span></div>
        <div class="usage-grid">
            <div class="usage-card"><span>@UiText.Get("Branches")</span><strong>@Model.CurrentEntitlement.BranchesUsed <small>/ @(Model.CurrentEntitlement.MaxBranches > 0 ? Model.CurrentEntitlement.MaxBranches.ToString() : UiText.Get("Unlimited"))</small></strong><div class="usage-meter"><span style="width:@UsagePercent(Model.CurrentEntitlement.BranchesUsed, Model.CurrentEntitlement.MaxBranches)%"></span></div></div>
            <div class="usage-card"><span>@UiText.Get("Menu items")</span><strong>@Model.CurrentEntitlement.MenuItemsUsed <small>/ @(Model.CurrentEntitlement.MaxMenuItems > 0 ? Model.CurrentEntitlement.MaxMenuItems.ToString() : UiText.Get("Unlimited"))</small></strong><div class="usage-meter"><span style="width:@UsagePercent(Model.CurrentEntitlement.MenuItemsUsed, Model.CurrentEntitlement.MaxMenuItems)%"></span></div></div>
            <div class="usage-card"><span>@UiText.Get("Users")</span><strong>@Model.CurrentEntitlement.UsersUsed <small>/ @(Model.CurrentEntitlement.MaxUsers > 0 ? Model.CurrentEntitlement.MaxUsers.ToString() : UiText.Get("Unlimited"))</small></strong><div class="usage-meter"><span style="width:@UsagePercent(Model.CurrentEntitlement.UsersUsed, Model.CurrentEntitlement.MaxUsers)%"></span></div></div>
        </div>
    </section>
}

<section class="surface"><div class="section-heading"><div><span class="eyebrow">Plan catalog</span><h2>Plans</h2></div></div>
    <div class="data-table" data-columns="7"><div class="table-row table-heading"><span>Plan</span><span>Monthly price</span><span>Branches</span><span>Menu items</span><span>Users</span><span>Features</span><span>Action</span></div>
    @foreach (var plan in Model.Plans)
    {
        var planPrice = plan.MonthlyPrice.ToString("0.00");
        var isCurrentPlan = Model.CurrentSubscription?.PlanId == plan.Id && Model.CurrentSubscription.Status is RestaurantMenuPlatform.Domain.Enums.SubscriptionStatus.Active or RestaurantMenuPlatform.Domain.Enums.SubscriptionStatus.Trial;
        <div class="table-row"><span><strong>@plan.Name</strong>@if (isCurrentPlan) { <small class="status status-live">@UiText.Get("Current plan")</small> }</span><span>@planPrice @plan.Currency / @UiText.Get("month")</span><span>@(plan.MaxBranches > 0 ? plan.MaxBranches : UiText.Get("Unlimited"))</span><span>@(plan.MaxMenuItems > 0 ? plan.MaxMenuItems : UiText.Get("Unlimited"))</span><span>@(plan.MaxUsers > 0 ? plan.MaxUsers : UiText.Get("Unlimited"))</span><span>@string.Join(", ", plan.Features.Where(x => x.Enabled).Select(x => x.FeatureKey))</span><span>@if (!isCurrentPlan) { <form action="@(tenantPath)/Billing/InitiatePayment" method="post" class="inline-form" data-confirm data-confirm-title="@UiText.Get("Choose subscription plan")" data-confirm-message="@UiText.Get("Start the subscription checkout for") @plan.Name @UiText.Get("at") @planPrice @plan.Currency / @UiText.Get("month")? @UiText.Get("Payment is not considered complete until the provider confirms it.")" data-confirm-label="@UiText.Get("Continue to payment")" data-confirm-tone="warning">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@plan.Id" /><button class="btn btn-secondary" type="submit">@UiText.Get("Choose plan")</button></form> } else { <span class="muted">@UiText.Get("Active")</span> }</span></div>
    }
    </div>
</section>

@functions {
    private static int UsagePercent(int usage, int limit)
    {
        if (limit <= 0)
            return 0;
        return Math.Clamp((int)Math.Round(usage * 100d / limit), 0, 100);
    }
}

<section class="surface"><div class="section-heading"><div><span class="eyebrow">Subscription history</span><h2>Subscriptions</h2></div></div>
    @if (Model.SubscriptionHistory.Count == 0) { <div class="empty-state"><h2>No subscription history.</h2></div> } else {
    <div class="data-table" data-columns="4"><div class="table-row table-heading"><span>Plan</span><span>Status</span><span>Start</span><span>End</span></div>
    @foreach (var subscription in Model.SubscriptionHistory) { <div class="table-row"><span>@subscription.PlanName</span><span>@subscription.Status</span><span>@subscription.StartsAtUtc.ToLocalTime().ToString("dd MMM yyyy")</span><span>@(subscription.EndsAtUtc?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</span></div> }
    </div> }
</section>

<section class="surface"><div class="section-heading"><div><span class="eyebrow">Provider callbacks</span><h2>Payments</h2></div></div>
    @if (Model.Payments.Count == 0) { <div class="empty-state"><h2>No payments recorded.</h2></div> } else {
    <div class="data-table" data-columns="5"><div class="table-row table-heading"><span>Created</span><span>Provider</span><span>Reference</span><span>Amount</span><span>Status</span></div>
    @foreach (var payment in Model.Payments) { <div class="table-row"><span>@payment.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span><span>@payment.Provider</span><span>@payment.ProviderReference</span><span>@payment.Amount.ToString("0.00") @payment.Currency</span><span>@payment.Status</span></div> }
    </div> }
</section>
