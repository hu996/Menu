@model RestaurantMenuPlatform.Web.Models.BranchOverrideEditViewModel
@{ ViewData["Title"] = "Edit branch override"; var tenantSlug = Context.Request.RouteValues["tenantSlug"]?.ToString(); var editAction = string.IsNullOrWhiteSpace(tenantSlug) ? "/BranchMenus/Edit" : $"/r/{tenantSlug}/BranchMenus/Edit"; }
<div class="page-header"><span class="eyebrow">@Model.BranchName · branch override</span><h1>@Model.ItemName</h1><p class="muted">Global price: @Model.GlobalPrice.ToString("0.00"). Leave a value blank to follow the global menu.</p></div>
<form action="@editAction" method="post" class="form-stack premium-form narrow-form"><input asp-for="BranchId" type="hidden" /><input asp-for="MenuItemId" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Branch-specific pricing</span><h2>Price override</h2><p>Leave the value blank when this branch should inherit the global product price.</p></div><div class="form-field"><label asp-for="PriceOverride"></label><input asp-for="PriceOverride" type="number" step="0.01" inputmode="decimal" placeholder="Use global price" /></div></section>
    <section class="form-section"><div class="form-section-heading"><span class="eyebrow">Guest visibility</span><h2>Availability & visibility</h2><p>These overrides affect only this branch menu.</p></div><div class="form-grid"><div class="form-field"><label asp-for="IsAvailableOverride"></label><select asp-for="IsAvailableOverride"><option value="">Use global availability</option><option value="true">Available</option><option value="false">Unavailable</option></select></div><div class="form-field"><label asp-for="IsVisibleOverride"></label><select asp-for="IsVisibleOverride"><option value="">Visible by default</option><option value="true">Visible</option><option value="false">Hidden</option></select></div></div></section>
    @Html.AntiForgeryToken()<div class="form-actions-sticky"><a class="btn btn-secondary" asp-controller="Products" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save override</button></div>
</form>
