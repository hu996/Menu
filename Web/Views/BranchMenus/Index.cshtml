@model IReadOnlyList<RestaurantMenuPlatform.Web.Models.BranchOverrideViewModel>
@{
    ViewData["Title"] = "Branch menu overrides";
}
<div class="page-header"><span class="eyebrow">Branch menu</span><h1>Overrides</h1><p class="muted">Global menu values remain the default. Change only what this branch needs.</p></div>
@if (Model.Count == 0)
{
    <div class="empty-state"><h2>No overrides yet.</h2><p class="muted">This branch currently follows global menu values.</p></div>
}
else
{
    <div class="data-table" data-columns="5">
        <div class="table-row table-heading"><span>Item</span><span>Global price</span><span>Effective price</span><span>Availability</span><span></span></div>
        @foreach (var item in Model)
        {
            <div class="table-row"><span>@item.ItemName</span><span>@item.GlobalPrice.ToString("0.00")</span><span>@item.EffectivePrice.ToString("0.00")</span><span>@(item.IsAvailable && item.IsVisible ? "Visible" : "Hidden")</span><span><a class="text-link" asp-action="Edit" asp-route-branchId="@item.BranchId" asp-route-menuItemId="@item.MenuItemId">Edit</a></span></div>
        }
    </div>
}
