@model RestaurantMenuPlatform.Web.Models.BranchViewModel
@{ ViewData["Title"] = "Edit branch"; }
<div class="page-header"><span class="eyebrow">Operations</span><h1>Edit @Model.Name</h1><p class="muted">The public branch address remains /@Model.Slug.</p></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-stack premium-form">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <section class="form-section">
        <div class="form-section-heading"><span class="eyebrow">Identity</span><h2>Branch information</h2><p>Update the bilingual guest-facing identity without changing the permanent route.</p></div>
        <div class="form-grid">
            <div class="form-field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="field-validation"></span></div>
            <div class="form-field"><label asp-for="NameAr"></label><input asp-for="NameAr" dir="rtl" /></div>
            <div class="form-field form-field-full"><label asp-for="Address"></label><input asp-for="Address" /></div>
            <div class="form-field"><label asp-for="Phone"></label><input asp-for="Phone" autocomplete="tel" /></div>
        </div>
    </section>
    <section class="form-section">
        <div class="form-section-heading"><span class="eyebrow">Location & service</span><h2>Operational details</h2><p>Keep coordinates and service hours current for this location.</p></div>
        <div class="form-grid"><div class="form-field"><label asp-for="Latitude"></label><input asp-for="Latitude" type="number" step="0.000001" inputmode="decimal" /></div><div class="form-field"><label asp-for="Longitude"></label><input asp-for="Longitude" type="number" step="0.000001" inputmode="decimal" /></div><div class="form-field form-field-full"><label asp-for="OpeningHours"></label><textarea asp-for="OpeningHours" rows="4"></textarea></div></div>
    </section>
    <section class="form-section">
        <div class="form-section-heading"><span class="eyebrow">Branding</span><h2>Branch overrides</h2><p>Choose colors only when this location needs to differ from restaurant defaults.</p></div>
        @if (Model.CanCustomizeBranding)
        {
            <div class="form-grid"><div class="form-field"><label asp-for="BrandPrimaryColorOverride"></label><input asp-for="BrandPrimaryColorOverride" type="color" /></div><div class="form-field"><label asp-for="BrandAccentColorOverride"></label><input asp-for="BrandAccentColorOverride" type="color" /></div></div>
        }
        else
        {
            <p class="field-hint">Branch color overrides are available on plans that include custom branding. The restaurant defaults remain active.</p>
        }
    </section>
    @Html.AntiForgeryToken()
    <div class="form-actions-sticky"><a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a><button class="btn btn-primary" type="submit">Save changes</button></div>
</form>
